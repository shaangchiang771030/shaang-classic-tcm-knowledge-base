---
const p = Astro.url.pathname;
const isEn = p === '/en' || p.startsWith('/en/');
const prefix = isEn ? '/en' : '';
const items = isEn
  ? [
      ['Home', `${prefix}/`], ['Research', `${prefix}/research/`], ['Start Here', `${prefix}/start-here/`],
      ['About', `${prefix}/about/`], ['Food Report', `${prefix}/food-report/`],
    ]
  : [
      ['首頁', '/'], ['研究領域', '/research/'], ['開始閱讀', '/start-here/'], ['關於', '/about/'], ['食療報告', '/food-report/'],
    ];
---
<nav class="cosmos-header-nav" aria-label={isEn ? 'Primary navigation' : '主要導覽'}>
  {items.map(([label, href]) => <a href={href}>{label}</a>)}
</nav>
